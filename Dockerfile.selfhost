# Self-host Dockerfile for the BregSurv agent — bundles vLLM + Qwen 2.5-7B-AWQ
# alongside the R package and Gradio UI. Image runs end-to-end on a single
# host with an NVIDIA GPU (≥ 12 GB VRAM); no external LLM API call leaves
# the machine.
#
# Compare with `Dockerfile` (HF Space): same R + BregSurv install, same
# `app.py`, but adds CUDA + vLLM and points the agent at localhost:8000
# instead of OpenAI. The two files are intentionally NOT factored into a
# shared base — their FROMs (python:3.11-slim vs nvidia/cuda) and final
# sizes (~3 GB vs ~10 GB) are too different to share usefully. If you
# change the R-deps list or the BregSurv install pattern here, mirror the
# edit in `Dockerfile` and vice versa.
#
# Build:
#   docker build -f Dockerfile.selfhost -t bregsurv-agent:selfhost .
#
# Run (minimal):
#   docker run --rm --gpus all -p 7860:7860 \
#       -v bregsurv-models:/root/.cache/huggingface \
#       bregsurv-agent:selfhost
#
# Run (with user data mounted):
#   docker run --rm --gpus all -p 7860:7860 \
#       -v bregsurv-models:/root/.cache/huggingface \
#       -v "$PWD/my_data:/data" \
#       bregsurv-agent:selfhost
#
# See mcp/DEPLOY.md for the full recipe (prerequisites, troubleshooting,
# docker-compose alternative).

# --------------------------------------------------------------------
# Base — CUDA 12.4 devel (NOT runtime). The devel variant ships `nvcc`,
# which flashinfer needs at vLLM startup to JIT-compile a kernel. Using
# the runtime image instead manifests as:
#   RuntimeError: Could not find nvcc and default cuda_home='/usr/local/
#   cuda' doesn't exist
# deep inside flashinfer. Don't optimise this by switching to runtime.
# --------------------------------------------------------------------
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# --------------------------------------------------------------------
# System packages
#
# Mirrors Dockerfile's apt list (the *-dev / fonts / locales lessons
# apply identically to ubuntu22.04). Additions for self-host:
#   * python3.11 from deadsnakes PPA — matches HF Space's interpreter
#     version. Ubuntu 22.04's system python3 is 3.10, which works for
#     bregsurv_agent (needs ≥ 3.8) but vLLM has had 3.10-specific bugs
#     historically; 3.11 is the recommended target.
#   * software-properties-common: to add deadsnakes PPA.
# --------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common ca-certificates curl gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && curl -fsSL https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc \
       | gpg --dearmor -o /usr/share/keyrings/cran-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cran-archive-keyring.gpg] https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/" \
       > /etc/apt/sources.list.d/cran.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-dev python3-pip \
      r-base r-base-dev \
      build-essential gfortran pkgconf \
      libxml2-dev libssl-dev libcurl4-openssl-dev \
      libpango1.0-dev libcairo2-dev \
      libharfbuzz-dev libfribidi-dev \
      libfreetype6-dev libfontconfig1-dev \
      libpng-dev libjpeg-dev libtiff-dev \
      libmagick++-dev \
      libuv1-dev libsodium-dev libgit2-dev libsecret-1-dev \
      libffi-dev \
      fonts-dejavu-core fonts-liberation \
      shared-mime-info locales \
    && sed -i '/^# en_US.UTF-8/s/^# //' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# Make python3.11 the default `python` / `pip`.
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python

# --------------------------------------------------------------------
# R packages — SAME list as Dockerfile. The DESCRIPTION Imports list
# is the canonical source of truth. Past Stage 4c lesson: missing any
# of dplyr/reshape2/rlang/mvtnorm/scales here causes R CMD INSTALL of
# BregSurv to fail at "dependencies not available".
#
# Repo strategy: Posit PPM Jammy binaries first, CRAN source fallback.
# See Stage 4f Dockerfile commentary for why — short version: rms +
# Hmisc compile-from-source fails on this Ubuntu 22.04 + R 4.1.2
# stack, breaking riskRegression transitively. PPM serves pre-built
# binaries that sidestep the whole compile chain. Keep in sync with
# Dockerfile's R-install block.
# --------------------------------------------------------------------
RUN R -e " \
    options(repos = c( \
      PPM = 'https://packagemanager.posit.co/cran/__linux__/jammy/latest', \
      CRAN = 'https://cloud.r-project.org' \
    ), HTTPUserAgent = sprintf('R/%s R (%s)', getRversion(), paste(getRversion(), R.version[['platform']], R.version[['arch']], R.version[['os']])), Ncpus = 4); \
    install.packages(c( \
      'Rcpp', 'RcppArmadillo', \
      'ggplot2', 'cowplot', 'Matrix', 'rlang', \
      'riskRegression', 'dplyr', 'reshape2', \
      'survival', 'MASS', 'mvtnorm', 'scales', \
      'rBayesianOptimization', \
      'jsonlite', 'remotes' \
    ), dependencies = c('Depends', 'Imports', 'LinkingTo')); \
    missing <- c('Rcpp','RcppArmadillo','ggplot2','cowplot','Matrix','rlang','riskRegression','dplyr','reshape2','survival','MASS','mvtnorm','scales','rBayesianOptimization','jsonlite','remotes'); \
    missing <- missing[!missing %in% rownames(installed.packages())]; \
    if (length(missing)) stop('Failed to install: ', paste(missing, collapse=', ')); \
    cat('R deps installed; library:', .libPaths()[1], '\n')"

# --------------------------------------------------------------------
# Python deps — base UI (from requirements.txt) + vLLM.
#
# vLLM is pinned loosely (>=0.6.0,<0.8.0). The 0.6/0.7 line tracks Qwen
# 2.5 and supports `--tool-call-parser hermes` + `--enable-auto-tool-
# choice` (added in 0.6.0). vLLM 0.8+ rewrote the scheduler and the
# hermes parser interface changed; revisit once we want to upgrade.
# `huggingface_hub[cli]` is needed so the entrypoint can call `hf
# download` for model weights on first boot.
# --------------------------------------------------------------------
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt \
    && pip install \
       "vllm==0.6.6.post1" \
       "transformers==4.46.3" \
       "huggingface_hub[cli]>=0.20"

# --------------------------------------------------------------------
# BregSurv R package — installed from local source (no network call,
# no GitHub dependency). Identical to Dockerfile.
# --------------------------------------------------------------------
COPY DESCRIPTION NAMESPACE /app/_bregsurv_pkg/
COPY R/    /app/_bregsurv_pkg/R/
COPY src/  /app/_bregsurv_pkg/src/
COPY man/  /app/_bregsurv_pkg/man/
COPY data/ /app/_bregsurv_pkg/data/

RUN R CMD INSTALL --no-docs --no-multiarch /app/_bregsurv_pkg \
    && R -e "library(BregSurv); cat('BregSurv installed:', as.character(packageVersion('BregSurv')), '\n')"

# Application files — kept last so edits don't bust the slow R-install layer.
COPY mcp/r_scripts/ /app/mcp/r_scripts/
COPY mcp/server.py /app/mcp/server.py
COPY mcp/entrypoint.sh /app/mcp/entrypoint.sh
COPY data/ /app/data/
COPY bregsurv_agent/ /app/bregsurv_agent/
COPY app.py generate_transcripts.py /app/
RUN chmod +x /app/mcp/entrypoint.sh

# --------------------------------------------------------------------
# Runtime configuration
#
# vLLM is local: agent points at 127.0.0.1:8000/v1, dummy API key.
# Model weights cached at /root/.cache/huggingface — mount a volume
# here to persist across `docker run --rm` invocations.
# --------------------------------------------------------------------
ENV GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    DEPLOYMENT_MODE=local \
    SURVBREGDIV_RSCRIPT=/usr/bin/Rscript \
    SURVBREGDIV_R_SCRIPTS=/app/mcp/r_scripts \
    SURVBREGDIV_MODEL_ENDPOINT=http://127.0.0.1:8000/v1 \
    SURVBREGDIV_MODEL_NAME=qwen2.5-7b-awq \
    OPENAI_API_KEY=EMPTY \
    VLLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ \
    VLLM_HOST=127.0.0.1 \
    VLLM_PORT=8000 \
    VLLM_MAX_MODEL_LEN=32768 \
    VLLM_GPU_MEM_UTIL=0.5 \
    HF_HOME=/root/.cache/huggingface \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PYTHONIOENCODING=utf-8

EXPOSE 7860

# Health probe — Gradio responds on / once both vLLM AND app.py are up.
# Longer start-period than the HF Space image because first boot also
# downloads ~5.2 GB of model weights (network-bound).
HEALTHCHECK --interval=60s --timeout=10s --start-period=600s --retries=3 \
    CMD curl -fs http://127.0.0.1:7860/ >/dev/null || exit 1

ENTRYPOINT ["/app/mcp/entrypoint.sh"]
