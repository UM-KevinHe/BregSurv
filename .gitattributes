# Line-ending policy for the BregSurv repo.
# Line endings are normalised so scripts run on Linux /
# Docker (bash) and the R/Python sources keep LF regardless of local platform.

# Auto-normalize text files; git auto-detects and leaves true binaries alone.
* text=auto

# Code & scripts pinned to LF (must stay LF for Docker, bash, R and Python).
*.sh      text eol=lf
*.sbatch  text eol=lf
*.R       text eol=lf
*.r       text eol=lf
*.py      text eol=lf
*.Rmd     text eol=lf
*.bst     text eol=lf
Makevars  text eol=lf

# Common binaries — never convert.
*.rda   binary
*.RData binary
*.rds   binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff2 binary
*.gz    binary
*.zip   binary
*.mcpb  binary
*.o     binary
*.so    binary
*.dll   binary
